+        const uint32_t qlb = (qlp >> (8*k)) & 0xFF;
+        const uint32_t qhb = (qhp >> (8*k)) & 0xFF;
+        const uint32_t nib = j < 2 ? (qlb & 0xF) : (qlb >> 4);
+        const int      q   = (int8_t) (nib | (((qhb >> (2*j)) & 3) << 4));
+        ys[k] = ggml_cuda_cast<dst_t>(d * sc * (q - 32));
+    }
