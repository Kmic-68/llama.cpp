+// --- verification harness (env LLAMA_TENSOR_HASH=1): FNV-1a over full tensor bytes ---
+static bool common_hash_mode() {
+    static const bool on = getenv("LLAMA_TENSOR_HASH") != nullptr;
+    return on;
+}
+
+static uint64_t common_fnv1a(const uint8_t * p, size_t n) {
+    uint64_t h = 1469598103934665603ULL;
+    for (size_t i = 0; i < n; ++i) {
+        h ^= (uint64_t) p[i];
+        h *= 1099511628211ULL;
+    }
+    return h;
+}
