             CUDA_CHECK(cudaMemcpyPeerAsync(dst->data, dst_physical, src->data, src_physical, ggml_nbytes(dst), copy_stream));
             CUDA_CHECK(cudaEventRecord(cuda_ctx_src->copy_event, copy_stream));
 
