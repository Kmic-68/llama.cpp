+// TEMP DEBUG (remove before commit): GGML_CUDA_DBG_NODEHASH=1 prints (to stderr: llama's log callback drops ggml INFO) a hash of every computed node's
+// output bytes, to compare whole forward passes bit-for-bit across runs. One thread per 1024-word
+// block; the thread only loads the tensor and stores once into a separate buffer.
+static __global__ void dbg_nodehash_blocks(const uint32_t * w, uint32_t * out, const int64_t nwords, const int64_t nblocks) {
+    const int64_t b = (int64_t) blockDim.x*blockIdx.x + threadIdx.x;
+    if (b >= nblocks) {
+        return;
+    }
+    const int64_t start = b*1024;
+    const int64_t end   = start + 1024 < nwords ? start + 1024 : nwords;
+    uint32_t h1 = 0x811c9dc5u ^ (uint32_t) b;
+    uint32_t h2 = 0x9e3779b9u + (uint32_t) b;
+    for (int64_t i = start; i < end; i++) {
+        const uint32_t x = w[i];
+        h1 = (h1 ^ x) * 16777619u;
+        h2 = (h2 + x) * 2654435761u + (uint32_t) i;
+    }
+    out[b] = h1 ^ (h2 * 2246822519u);
+}
+
+// mode 2: fold the block hashes on the GPU into one slot per node, read back once per graph, so the
+// op sequence runs with no host synchronize between nodes (a synchronize once masked the softmax race)
+static __global__ void dbg_nodehash_fold(const uint32_t * in, uint32_t * out, const int64_t n, const int64_t slot) {
+    uint32_t h = 0x811c9dc5u ^ (uint32_t) n;
+    for (int64_t i = 0; i < n; i++) {
+        h = (h ^ in[i]) * 16777619u;
+        h ^= h >> 15;
+    }
+    out[slot] = h;
+}
+
+static int dbg_nodehash_mode() {
+    static const int v = [] { const char * s = getenv("GGML_CUDA_DBG_NODEHASH"); return s ? atoi(s) : 0; }();
+    return v;
+}
+static bool dbg_nodehash_enabled() { return dbg_nodehash_mode() != 0; }
+
+struct dbg_nodehash_deferred {
+    uint32_t * slots = nullptr;
+    int64_t    cap   = 0;
+    std::vector<std::string> labels;
+};
+static dbg_nodehash_deferred dbg_nh_deferred[GGML_CUDA_MAX_DEVICES];
+static std::atomic<uint64_t> dbg_nh_seq{0};
+
+static void dbg_nodehash_flush(ggml_backend_cuda_context * cuda_ctx) {
+    dbg_nodehash_deferred & d = dbg_nh_deferred[cuda_ctx->device];
+    if (d.labels.empty()) {
+        return;
+    }
+    std::vector<uint32_t> host(d.labels.size());
+    CUDA_CHECK(cudaStreamSynchronize(cuda_ctx->stream()));
+    CUDA_CHECK(cudaMemcpy(host.data(), d.slots, host.size()*sizeof(uint32_t), cudaMemcpyDeviceToHost));
+    for (size_t k = 0; k < host.size(); k++) {
+        fprintf(stderr, "%s h=%08x\n", d.labels[k].c_str(), host[k]);
+    }
+    d.labels.clear();
+}
+
+// mode 3: count non-finite values in every F32 node output; print the first nodes that have any
+static __global__ void dbg_nonfinite_blocks(const uint32_t * w, uint32_t * out, const int64_t nwords, const int64_t nblocks) {
+    const int64_t b = (int64_t) blockDim.x*blockIdx.x + threadIdx.x;
+    if (b >= nblocks) {
+        return;
+    }
+    const int64_t start = b*1024;
+    const int64_t end   = start + 1024 < nwords ? start + 1024 : nwords;
+    uint32_t c = 0;
+    for (int64_t i = start; i < end; i++) {
+        c += ((w[i] >> 23) & 0xff) == 0xff ? 1u : 0u;
+    }
+    out[b] = c;
+}
+
+static void dbg_nonfinite(ggml_backend_cuda_context * cuda_ctx, const ggml_tensor * node, int idx) {
+    static std::atomic<int> printed{0};
+    static std::atomic<uint64_t> checked{0};
+    if (node->type != GGML_TYPE_F32 || node->data == nullptr || printed.load() >= 40) {
+        return;
+    }
+    const int64_t nwords = (int64_t) (ggml_nbytes(node) / 4);
+    if (nwords == 0) {
+        return;
+    }
+    const int64_t nblocks = (nwords + 1023) / 1024;
+    ggml_cuda_pool_alloc<uint32_t> out(cuda_ctx->pool(), nblocks);
+    const int bs = 256;
+    const int64_t ngrid = (nblocks + bs - 1) / bs;
+    GGML_ASSERT(ngrid <= INT_MAX);
+    dbg_nonfinite_blocks<<<dim3((unsigned) ngrid, 1, 1), dim3(bs, 1, 1), 0, cuda_ctx->stream()>>>(
+        (const uint32_t *) node->data, out.get(), nwords, nblocks);
+    std::vector<uint32_t> host(nblocks);
+    CUDA_CHECK(cudaStreamSynchronize(cuda_ctx->stream()));
+    CUDA_CHECK(cudaMemcpy(host.data(), out.get(), nblocks*sizeof(uint32_t), cudaMemcpyDeviceToHost));
+    uint64_t total = 0; int64_t first = -1;
+    for (int64_t k = 0; k < nblocks; k++) { total += host[k]; if (host[k] && first < 0) { first = k; } }
+    const uint64_t n = checked++;
+    if (total > 0) {
+        printed++;
+        fprintf(stderr, "NONFINITE dev=%d check=%llu i=%d op=%s name=%s ne=%lld,%lld,%lld,%lld count=%llu first_word=%lld src0=%s src1=%s\n",
+            cuda_ctx->device, (unsigned long long) n, idx, ggml_op_desc(node), node->name,
+            (long long) node->ne[0], (long long) node->ne[1], (long long) node->ne[2], (long long) node->ne[3],
+            (unsigned long long) total, (long long) first*1024,
+            node->src[0] ? node->src[0]->name : "-", node->src[1] ? node->src[1]->name : "-");
+    }
+}
+
+static void dbg_nodehash(ggml_backend_cuda_context * cuda_ctx, const ggml_tensor * node, int idx) {
+    const int64_t nbytes = (int64_t) ggml_nbytes(node);
+    const int64_t nwords = nbytes / 4;
+    if (dbg_nodehash_mode() == 3) {
+        dbg_nonfinite(cuda_ctx, node, idx);
+        return;
+    }
+    if (dbg_nodehash_mode() == 2) {
+        dbg_nodehash_deferred & d = dbg_nh_deferred[cuda_ctx->device];
+        if (d.slots == nullptr) {
+            d.cap = 1 << 20;
+            CUDA_CHECK(cudaMalloc((void **) &d.slots, d.cap*sizeof(uint32_t)));
+        }
+        GGML_ASSERT((int64_t) d.labels.size() < d.cap);
+        const int64_t slot = (int64_t) d.labels.size();
+        char label[512];
+        snprintf(label, sizeof(label), "NODEHASH dev=%d seq=%llu i=%d op=%s name=%s ne=%lld,%lld,%lld,%lld",
+            cuda_ctx->device, (unsigned long long) dbg_nh_seq++, idx, ggml_op_desc(node), node->name,
+            (long long) node->ne[0], (long long) node->ne[1], (long long) node->ne[2], (long long) node->ne[3]);
+        d.labels.emplace_back(label);
+        if (node->data == nullptr || nwords == 0) {
+            CUDA_CHECK(cudaMemsetAsync(d.slots + slot, 0, sizeof(uint32_t), cuda_ctx->stream()));
+            return;
+        }
+        const int64_t nblocks = (nwords + 1023) / 1024;
+        ggml_cuda_pool_alloc<uint32_t> out(cuda_ctx->pool(), nblocks);
+        const int bs = 256;
+        const int64_t ngrid = (nblocks + bs - 1) / bs;
+        GGML_ASSERT(ngrid <= INT_MAX);
+        dbg_nodehash_blocks<<<dim3((unsigned) ngrid, 1, 1), dim3(bs, 1, 1), 0, cuda_ctx->stream()>>>(
+            (const uint32_t *) node->data, out.get(), nwords, nblocks);
+        dbg_nodehash_fold<<<dim3(1, 1, 1), dim3(1, 1, 1), 0, cuda_ctx->stream()>>>(out.get(), d.slots, nblocks, slot);
+        return;
+    }
+    uint64_t h = 1469598103934665603ull ^ (uint64_t) nbytes;
+    const uint64_t seq = dbg_nh_seq++;
+    if (node->data != nullptr && nwords > 0) {
+        const int64_t nblocks = (nwords + 1023) / 1024;
+        ggml_cuda_pool_alloc<uint32_t> out(cuda_ctx->pool(), nblocks);
+        const int bs = 256;
+        const int64_t ngrid = (nblocks + bs - 1) / bs;
+        GGML_ASSERT(ngrid <= INT_MAX);
+        dbg_nodehash_blocks<<<dim3((unsigned) ngrid, 1, 1), dim3(bs, 1, 1), 0, cuda_ctx->stream()>>>(
+            (const uint32_t *) node->data, out.get(), nwords, nblocks);
+        std::vector<uint32_t> host(nblocks);
+        CUDA_CHECK(cudaStreamSynchronize(cuda_ctx->stream()));
+        CUDA_CHECK(cudaMemcpy(host.data(), out.get(), nblocks*sizeof(uint32_t), cudaMemcpyDeviceToHost));
+        for (int64_t k = 0; k < nblocks; k++) {
+            h = (h ^ host[k]) * 1099511628211ull;
+        }
+    }
+    fprintf(stderr, "NODEHASH dev=%d seq=%llu i=%d op=%s name=%s ne=%lld,%lld,%lld,%lld h=%016llx\n",
+        cuda_ctx->device, (unsigned long long) seq, idx, ggml_op_desc(node), node->name,
+        (long long) node->ne[0], (long long) node->ne[1], (long long) node->ne[2], (long long) node->ne[3],
+        (unsigned long long) h);
+}
